  "syntax_rules": {
    "compound_symbols": "merge adjacent nouns/verbs to form composite meanings",
    "connector_position": "between_clauses",
    "operator_position": "before_verb",
    "punctuation": {
      "·": "soft pause",
      "—": "hard break",
      "∎": "end of statement"
    },
    "word_order": "Subject-Verb-Object"
  },
  "translation_examples": [
