      "type": "operator"
    },
    "∞": {
      "meaning": "infinity",
      "syntax_role": "object",
      "type": "noun"
    },
    "∴": {
      "meaning": "therefore",
      "syntax_role": "logical_link",
      "type": "connector"
    },
    "⊕": {
      "meaning": "union",
      "syntax_role": "action",
      "type": "operator"
    },
    "⊗": {
